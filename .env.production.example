WEAVIATE_HOST_URL=weaviate
WEAVIATE_PORT=8080
WEAVIATE_GRPC_HOST_URL=weaviate
WEAVIATE_GRPC_PORT=50051
WEAVIATE_SECURE=false
WEAVIATE_RESET_SCHEMA=false

# Import behavior
# Keep existing Weaviate data by default. Set true to clear Testimonies and Chunks before import.
RESET_WEAVIATE_DATA=false
# Skip interviews that already have a Testimonies object and at least one Chunk.
SKIP_IMPORTED_INTERVIEWS=true

# Set the API key that matches features.chat.provider in config.json
# For Anthropic:
ANTHROPIC_API_KEY=

# For OpenAI:
OPENAI_API_KEY=

# For OpenAI-compatible providers:
AI_API_KEY=

# Site password (optional)
# When SITE_PASSWORD is set, every page and API route requires this shared password.
# Leave empty to keep the portal public.
SITE_PASSWORD=
# Required when SITE_PASSWORD is set. Signs the access cookie; changing it signs everyone out.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SITE_AUTH_SECRET=
